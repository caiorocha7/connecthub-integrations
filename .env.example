# =============================================================
# ConnectHub — variáveis de ambiente (copie para .env)
# Todos os valores abaixo são EXCLUSIVAMENTE para desenvolvimento.
# =============================================================

# Nome do projeto Compose (isola containers/volumes de outros projetos)
COMPOSE_PROJECT_NAME=connecthub

# ---- Portas expostas no host (ajuste se houver conflito) ----
CH_FRONTEND_PORT=4230
CH_API_PORT=8130
CH_SIMULATOR_PORT=8131
CH_POSTGRES_PORT=5442
CH_REDIS_PORT=6392

# ---- PostgreSQL ----
POSTGRES_USER=connecthub
POSTGRES_PASSWORD=connecthub_dev_password
POSTGRES_DB=connecthub

# ---- Segurança ----
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-6f1d0c1e9a7b4e2f8c3d5a1b7e9f0a2c
# Chave Fernet opcional para cifrar segredos de endpoints (derivada de SECRET_KEY se vazia)
FIELD_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- API ----
ENVIRONMENT=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8130
CORS_ORIGINS=http://localhost:4230,http://localhost:4200
MAX_PAYLOAD_BYTES=262144
SIGNATURE_TOLERANCE_SECONDS=300

# ---- Proteção SSRF ----
# Hosts internos permitidos explicitamente (o simulador local em dev).
# Endereços de metadados de nuvem continuam SEMPRE bloqueados.
SSRF_ALLOWED_HOSTS=simulator,localhost,127.0.0.1,host.docker.internal

# ---- Retentativas ----
RETRY_BASE_SECONDS=2
RETRY_MAX_SECONDS=300
DEFAULT_MAX_ATTEMPTS=5
OUTBOX_RELAY_INTERVAL_SECONDS=2

# ---- Usuário de demonstração (criado por `make seed` / scripts/seed) ----
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=Demo@12345
